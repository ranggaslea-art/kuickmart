rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pesan chat pelanggan dan admin toko
    match /chat_messages/{messageId} {
      allow read, write: if true;
    }
    // Room chat per session
    match /chats/{chatId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
    // Akun Pelanggan / Member LapakOke
    match /customer_accounts/{customerId} {
      allow read, write: if true;
    }
    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
