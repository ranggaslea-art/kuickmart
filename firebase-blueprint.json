{
  "entities": {
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Pesan chat real-time antara pelanggan dan admin toko",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID unik pesan chat"
        },
        "storeId": {
          "type": "string",
          "description": "ID atau slug toko terkait"
        },
        "storeName": {
          "type": "string",
          "description": "Nama toko tujuan chat"
        },
        "customerVisitorId": {
          "type": "string",
          "description": "ID unik pengunjung / pelanggan"
        },
        "customerName": {
          "type": "string",
          "description": "Nama pengirim pesan pelanggan"
        },
        "senderRole": {
          "type": "string",
          "enum": ["customer", "admin", "staff"],
          "description": "Peran pengirim pesan"
        },
        "senderName": {
          "type": "string",
          "description": "Nama pengirim pesan"
        },
        "text": {
          "type": "string",
          "description": "Isi pesan teks"
        },
        "createdAt": {
          "type": "number",
          "description": "Waktu pengiriman pesan dalam milidetik unix epoch"
        },
        "read": {
          "type": "boolean",
          "description": "Status pesan telah dibaca"
        }
      },
      "required": ["storeId", "customerVisitorId", "senderRole", "text", "createdAt"]
    },
    "CustomerAccount": {
      "title": "CustomerAccount",
      "description": "Akun data member / pelanggan toko LapakOke",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID unik pelanggan"
        },
        "name": {
          "type": "string",
          "description": "Nama lengkap pelanggan"
        },
        "phone": {
          "type": "string",
          "description": "Nomor WhatsApp atau handphone pelanggan"
        },
        "email": {
          "type": "string",
          "description": "Alamat email pelanggan"
        },
        "pin": {
          "type": "string",
          "description": "PIN atau password login pelanggan"
        },
        "memberNumber": {
          "type": "string",
          "description": "Nomor kartu member loyalitas"
        },
        "barcode": {
          "type": "string",
          "description": "Kode barcode kartu member"
        },
        "points": {
          "type": "number",
          "description": "Saldo poin loyalitas"
        },
        "stamps": {
          "type": "number",
          "description": "Jumlah stamp belanja"
        },
        "tier": {
          "type": "string",
          "enum": ["Bronze", "Silver", "Gold", "Platinum"],
          "description": "Tier keanggotaan"
        },
        "address": {
          "type": "string",
          "description": "Alamat utama pelanggan"
        },
        "city": {
          "type": "string",
          "description": "Kota tempat tinggal pelanggan"
        },
        "createdAt": {
          "type": "string",
          "description": "Waktu pendaftaran akun"
        },
        "lastLogin": {
          "type": "string",
          "description": "Waktu terakhir login"
        }
      },
      "required": ["id", "name", "phone", "memberNumber"]
    },
    "StoreBranch": {
      "title": "StoreBranch",
      "description": "Data cabang toko / outlet fisik yang tersinkronisasi lintas perangkat (PC, HP, Tablet)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID cabang toko"
        },
        "name": {
          "type": "string",
          "description": "Nama cabang toko"
        },
        "code": {
          "type": "string",
          "description": "Kode cabang toko"
        },
        "address": {
          "type": "string",
          "description": "Alamat lengkap cabang"
        },
        "city": {
          "type": "string",
          "description": "Kota cabang toko"
        },
        "phone": {
          "type": "string",
          "description": "Nomor telepon cabang"
        },
        "whatsapp": {
          "type": "string",
          "description": "Nomor WhatsApp cabang"
        },
        "isOpen": {
          "type": "boolean",
          "description": "Status buka toko"
        },
        "is24Hours": {
          "type": "boolean",
          "description": "Status buka 24 jam"
        },
        "openHours": {
          "type": "string",
          "description": "Jam operasional cabang"
        },
        "deliveryFee": {
          "type": "number",
          "description": "Tarif pengiriman dari cabang ini"
        },
        "minOrder": {
          "type": "number",
          "description": "Minimum belanja untuk pengiriman"
        },
        "updatedAt": {
          "type": "string",
          "description": "Waktu pembaruan data cabang"
        }
      },
      "required": ["id", "name", "address"]
    },
    "StoreTenant": {
      "title": "StoreTenant",
      "description": "Identitas subdomain dan data pengelola toko cabang di lapakoke.com",
      "type": "object",
      "properties": {
        "storeId": {
          "type": "string",
          "description": "ID unik tenant"
        },
        "storeSlug": {
          "type": "string",
          "description": "Slug subdomain toko"
        },
        "storeName": {
          "type": "string",
          "description": "Nama resmi toko"
        },
        "tagline": {
          "type": "string",
          "description": "Slogan atau moto toko"
        },
        "ownerName": {
          "type": "string",
          "description": "Nama pemilik / penanggung jawab toko"
        },
        "phone": {
          "type": "string",
          "description": "Nomor kontak telepon"
        },
        "whatsapp": {
          "type": "string",
          "description": "Nomor kontak WhatsApp"
        },
        "address": {
          "type": "string",
          "description": "Alamat fisik toko"
        },
        "city": {
          "type": "string",
          "description": "Kota domisili toko"
        },
        "logoUrl": {
          "type": "string",
          "description": "URL logo toko"
        },
        "logoText": {
          "type": "string",
          "description": "Inisial logo toko"
        },
        "primaryColor": {
          "type": "string",
          "description": "Warna tema utama toko"
        },
        "isActive": {
          "type": "boolean",
          "description": "Status aktif subdomain toko"
        },
        "updatedAt": {
          "type": "string",
          "description": "Waktu pembaruan tenant"
        }
      },
      "required": ["storeId", "storeSlug", "storeName"]
    },
    "LiveStreamComment": {
      "title": "LiveStreamComment",
      "description": "Komentar chat siaran langsung (live streaming) tersinkronisasi real-time antar perangkat (HP & Laptop)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID unik komentar"
        },
        "storeSlug": {
          "type": "string",
          "description": "Slug atau ID toko siaran live"
        },
        "storeName": {
          "type": "string",
          "description": "Nama toko yang menyiarkan live"
        },
        "senderName": {
          "type": "string",
          "description": "Nama pengunjung atau penonton yang mengirim komentar"
        },
        "senderId": {
          "type": "string",
          "description": "ID pengunjung / device"
        },
        "message": {
          "type": "string",
          "description": "Isi komentar obrolan siaran live"
        },
        "timestamp": {
          "type": "number",
          "description": "Waktu kirim unix epoch timestamp"
        },
        "isBuyer": {
          "type": "boolean",
          "description": "Apakah pengirim adalah pembeli / penonton"
        },
        "isHost": {
          "type": "boolean",
          "description": "Apakah pengirim adalah host / streamer toko"
        }
      },
      "required": ["storeSlug", "senderName", "message", "timestamp"]
    }
  },
  "firestore": {
    "/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Koleksi seluruh pesan chat real-time antara pelanggan dan admin toko"
    },
    "/live_stream_comments/{commentId}": {
      "schema": "LiveStreamComment",
      "description": "Koleksi komentar siaran langsung (live streaming) real-time multi-perangkat"
    },
    "/customer_accounts/{customerId}": {
      "schema": "CustomerAccount",
      "description": "Koleksi data pendaftaran dan profil akun pelanggan / member"
    },
    "/stores/{storeId}": {
      "schema": "StoreBranch",
      "description": "Koleksi cabang toko yang tersinkronisasi online di semua perangkat"
    },
    "/store_tenants/{tenantId}": {
      "schema": "StoreTenant",
      "description": "Koleksi pendaftaran subdomain toko cabang yang tersinkronisasi di semua perangkat"
    }
  }
}
